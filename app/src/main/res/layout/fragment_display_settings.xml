<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <FrameLayout
        android:id="@+id/bt_show_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/style_for_buttons_rectangle"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_show_wallpaper"
            style="@style/ButtonsText.Medium"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="15dp"
            android:paddingEnd="80dp"
            android:text="@string/show_wallpaper" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/cb_show_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginEnd="15dp"
            android:checked="false"
            android:clickable="false"
            android:focusable="false" />

    </FrameLayout>

</LinearLayout>
