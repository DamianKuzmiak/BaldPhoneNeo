<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnFinish">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:id="@+id/title"
                style="@style/BackgroundText.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onb_final_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summary"
                style="@style/BackgroundText.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/onb_final_summary" />

            <!-- PERMISSIONS CARD -->
            <LinearLayout
                android:id="@+id/card_permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?bald_button"
                android:padding="20dp"
                android:layout_marginTop="32dp">

                <TextView
                    android:id="@+id/permissions_header"
                    style="@style/BackgroundText.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_permissions_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/permissions_desc"
                    style="@style/BackgroundText.Medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/onb_permissions_desc" />

                <Button
                    android:id="@+id/btnOpenPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/onb_permissions_button" />

                <TextView
                    android:id="@+id/permissions_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/onb_permissions_done"
                    android:textColor="@color/green"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- HOME SCREEN CARD -->
            <LinearLayout
                android:id="@+id/card_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?bald_button"
                android:padding="20dp"
                android:layout_marginTop="24dp">

                <TextView
                    android:id="@+id/home_header"
                    style="@style/BackgroundText.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_home_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_desc"
                    style="@style/BackgroundText.Medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/onb_home_summary" />

                <Button
                    android:id="@+id/btnSetDefaultLauncher"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/onb_home_button" />

                <TextView
                    android:id="@+id/home_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/onb_home_already_set"
                    android:textColor="@color/green"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- FINISH BUTTON -->
    <Button
        android:id="@+id/btnFinish"
        style="@style/Bald.Button.FullWidth"
        android:text="@string/onb_finish_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
