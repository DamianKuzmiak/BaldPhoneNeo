<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <app.baldphone.neo.settings.views.SettingsSwitchButtonView
            android:id="@+id/bt_confirm_calls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:switchDescriptionOff="@string/settings_calls_confirm_calls_desc_off"
            app:switchDescriptionOn="@string/settings_calls_confirm_calls_desc_on"
            app:switchTitle="@string/settings_calls_confirm_calls_title" />

        <app.baldphone.neo.settings.views.SettingsSwitchButtonView
            android:id="@+id/bt_dual_sim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:switchDescriptionOff="@string/settings_calls_dual_sim_desc_off"
            app:switchDescriptionOn="@string/settings_calls_dual_sim_desc_on"
            app:switchTitle="@string/dual_sim"
            tools:visibility="visible" />

    </LinearLayout>

</ScrollView>
